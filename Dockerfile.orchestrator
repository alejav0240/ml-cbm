FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-audio.txt requirements-orchestrator.txt ./
RUN pip install --no-cache-dir -r requirements-orchestrator.txt

COPY . .
EXPOSE 8020

CMD ["python", "orchestrator_service.py", "--host", "0.0.0.0", "--port", "8020"]
